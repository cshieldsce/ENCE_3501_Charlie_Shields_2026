Mnmos@2 notB_output B vdd vdd PMOS L=0.6U W=1.8U
Mnmos@3 notB_output B gnd gnd NMOS L=0.6U W=1.8U
Mnmos@4 net@25 notB_output vdd vdd PMOS L=0.6U W=1.8U
Mnmos@5 Y A net@25 vdd PMOS L=0.6U W=1.8U
Mnmos@6 net@26 B vdd vdd PMOS L=0.6U W=1.8U
Mnmos@7 Y notA_output net@26 vdd PMOS L=0.6U W=1.8U
Mnmos@8 Y A net@27 gnd NMOS L=0.6U W=1.8U
Mnmos@9 net@27 B gnd gnd NMOS L=0.6U W=1.8U
Mnmos@10 Y notA_output net@28 gnd NMOS L=0.6U W=1.8U
Mnmos@11 net@28 notB_output gnd gnd NMOS L=0.6U W=1.8U
.ENDS ALU_cs__XOR

*** SUBCIRCUIT ALU_cs__FA FROM CELL ALU_cs:FA{sch}
.SUBCKT ALU_cs__FA A B Cin Cout Sum
** GLOBAL gnd
** GLOBAL vdd
XNAND_2@0 A B n2 ALU_cs__NAND
XNAND_2@1 n1 Cin n3 ALU_cs__NAND
XNAND_2@2 n3 n2 Cout ALU_cs__NAND
XXOR_2@0 A B n1 ALU_cs__XOR
XXOR_2@1 Cin n1 Sum ALU_cs__XOR
.ENDS ALU_cs__FA

*** SUBCIRCUIT ALU_cs__TRI FROM CELL ALU_cs:TRI{sch}
.SUBCKT ALU_cs__TRI D En Y
** GLOBAL gnd
** GLOBAL vdd
Mnmos@2 D_bar D gnd gnd NMOS L=0.6U W=1.8U
Mnmos@4 En_bar En gnd gnd NMOS L=0.6U W=1.8U
Mnmos@7 Y D_bar net@44 gnd NMOS L=0.6U W=1.8U
Mnmos@8 net@44 En gnd gnd NMOS L=0.6U W=1.8U
Mpmos@1 D_bar D vdd vdd PMOS L=0.6U W=1.8U
Mpmos@3 En_bar En vdd vdd PMOS L=0.6U W=1.8U
Mpmos@5 net@40 En_bar vdd vdd PMOS L=0.6U W=1.8U
Mpmos@6 Y D_bar net@40 vdd PMOS L=0.6U W=1.8U
.ENDS ALU_cs__TRI

*** SUBCIRCUIT ALU_cs__ALU4 FROM CELL ALU_cs:ALU4{sch}
.SUBCKT ALU_cs__ALU4 A0 A1 A2 A3 B0 B1 B2 B3 Cout En S0 S1 S2 S3 Sub
